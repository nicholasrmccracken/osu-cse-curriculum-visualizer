<!doctype html>
<html>
  <head>
    <meta charset="utf-8">
    <meta http-equiv="x-ua-compatible" content="ie=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">

    <title><%= current_page.data.title || "OSU Course Visualizer" %></title>
    <link rel="stylesheet" href="/stylesheets/site.css">
    <script type="module" src="/javascripts/site.js"></script>
  </head>
  <body>
    <header>
      <img id="logo" src="/images/buckeye-seal.png" alt="The Ohio State University Logo">
      <div class="page-info">
        <div>
          <h1>The Ohio State University Curriculum Visualizer</h1>
          <h2>Department of Computer Science and Engineering</h2>
          <h3>This tool provides a model schedule for a B.S. in Computer Science Engineering at The Ohio State University over 4 years.</h3>
        </div>
      </div>
    </header>

    <main>
      <%= yield %>
    </main>

    <footer>
      <nav>
        <ul>
          <li><a href="https://advising.osu.edu/schedule-appointment">Schedule Advising Appointment</a></li>
          <li><a href="mailto: compsciadvising@osu.edu">Contact Us</a></li>
          <li><a href="https://cse.osu.edu/sites/default/files/2023-03/CSE-Curriculum-Sheet-New-GE-IND-sample-schedule-with-GE-FINAL-1.pdf">Help</a></li>
        </ul>
      </nav>
      <p><br>2024 OSU Course Visualizer &copy; A Team CANS production</p>
    </footer>
  </body>
</html>
